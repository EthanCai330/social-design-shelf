.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node（构建 showcase 时）──────────────────────────
node_modules/
dist/
.pnpm-store/

